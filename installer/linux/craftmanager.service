[Unit]
Description=LocalMC CraftManager (Minecraft-Server-Verwaltung)
Documentation=file:///opt/craftmanager/LIESMICH.txt
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=craftmanager
Group=craftmanager
WorkingDirectory=/var/lib/craftmanager
Environment=CONFIG_FILE=/etc/craftmanager/craftmanager.env
Environment=NODE_ENV=production
# Ordner des privilegierten Updaters: status.json (nur lesbar), request/ (hier legt die Anwendung Update-Anfragen ab)
Environment=UPDATE_DIR=/var/lib/craftmanager-update
ExecStart=/opt/craftmanager/node/node /opt/craftmanager/app/backend/dist/index.js
# Neustart aus der Weboberfläche (Netzwerk-Einstellungen): die Anwendung beendet sich mit Code 75, systemd startet sie neu.
# Jeder Exit-Code ungleich 0 gilt bei on-failure als Fehler; 75 wird zusätzlich ausdrücklich genannt.
Restart=on-failure
RestartForceExitStatus=75
RestartSec=5

# Sauberes Beenden: systemd sendet SIGTERM nur an den Hauptprozess (KillMode=mixed). Die Anwendung stoppt dann
# alle Minecraft-Server mit "stop" (STOP_TIMEOUT_SECONDS, Standard 120 s, plus 15 s Reserve) und beendet sich.
# Erst nach TimeoutStopSec wird der Rest hart beendet (SIGKILL). Bei hoeherem STOP_TIMEOUT_SECONDS auch
# TimeoutStopSec erhoehen: sudo systemctl edit craftmanager
KillMode=mixed
KillSignal=SIGTERM
TimeoutStopSec=180
SendSIGHUP=no

UMask=0027
LimitNOFILE=65536

# Haertung. Bewusst NICHT gesetzt: MemoryDenyWriteExecute (Java/JIT braucht ausfuehrbaren, beschreibbaren Speicher)
# und SystemCallFilter (Java und Minecraft-Mods benoetigen sehr viele Systemaufrufe).
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/craftmanager /var/lib/craftmanager-update/request
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictNamespaces=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
SystemCallArchitectures=native
# Ports unter 1024 (z. B. PORT=80) ohne Root erlauben, sonst keine besonderen Rechte
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
