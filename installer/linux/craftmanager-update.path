[Unit]
Description=LanQuarry - update requests from the web interface
Documentation=file:///opt/craftmanager/README.txt

[Path]
# The application (user craftmanager) writes request.json last and atomically. The privileged updater checks
# everything again itself and deletes the request immediately so that it does not trigger again.
PathExists=/var/lib/craftmanager-update/request/request.json
Unit=craftmanager-update.service

[Install]
WantedBy=multi-user.target
