[Unit]
Description=LocalMC CraftManager - apply update (privileged)
Documentation=file:///opt/craftmanager/README.txt
# Deliberately NO dependency on craftmanager.service (no BindsTo/PartOf/Requires): stopping the application
# during the installation must not end this process.
After=network.target

[Service]
Type=oneshot
User=root
ExecStart=/opt/craftmanager/node/node /opt/craftmanager/tools/updater.mjs apply
TimeoutStartSec=1800
UMask=0022
# The updater replaces /opt/craftmanager including the Node executable that runs it; on Linux this is
# unproblematic (the opened file stays valid until the end), and it backs up the old version first.
