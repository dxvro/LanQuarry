# LocalMC CraftManager - Konfiguration
#
# Änderungen werden erst nach einem Neustart des Dienstes wirksam.
# Windows: Dienst "LocalMC CraftManager" in der Dienste-Verwaltung neu starten (services.msc).
# Linux:   sudo systemctl restart craftmanager
#
# Diese Datei enthält das Zugriffstoken. Sie darf nicht für alle Benutzer lesbar sein.

# Adresse und Port der Weboberfläche. 0.0.0.0 = aus dem ganzen Netzwerk erreichbar,
# 127.0.0.1 = nur auf diesem Rechner.
HOST=@HOST@
PORT=@PORT@

# Zugriffstoken für die Anmeldung (mindestens 8 Zeichen). Ohne Token hätte jeder im Netzwerk vollen Zugriff.
AUTH_TOKEN=@AUTH_TOKEN@

# Speicherorte. Datenbank, Java-Laufzeiten und Backups liegen in DATA_DIR, die Minecraft-Server in SERVERS_DIR.
DATA_DIR=@DATA_DIR@
SERVERS_DIR=@SERVERS_DIR@

# Fehlende Java-Versionen automatisch installieren (Eclipse Temurin, nur in DATA_DIR/runtimes)
JAVA_AUTO_INSTALL=true

# Wartezeit in Sekunden, die Minecraft-Server beim Beenden zum Speichern bekommen, bevor sie hart beendet werden.
# Der Dienst wartet höchstens etwa 180 Sekunden; wer mehr einstellt, muss auch den Dienst-Timeout anheben (siehe docs/INSTALL.md, Abschnitt 8, und docs/CONFIGURATION.md).
STOP_TIMEOUT_SECONDS=120

# Backups pro Mod, die nach Updates behalten werden (1 bis 100)
MOD_BACKUP_KEEP=3

# Log-Stufe: fatal, error, warn, info, debug, trace, silent
LOG_LEVEL=info

# Zusätzliche Hostnamen, unter denen die Oberfläche erreichbar sein soll (kommagetrennt, ohne Port).
# Der Rechnername und IP-Adressen funktionieren immer.
# ALLOWED_HOSTS=craft.example.lan
