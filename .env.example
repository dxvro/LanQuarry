# Alle Werte sind optional; hier stehen die Standardwerte.
# Adresse und Port der Weboberflaeche. Unter System > Netzwerk & Zugriff in der Weboberflaeche lassen sie sich aendern
# (gespeichert in der Datenbank, hat Vorrang); diese Werte sind der Rueckfall. 0.0.0.0 = alle Netzwerkadapter,
# 127.0.0.1 = nur dieser Rechner.
HOST=0.0.0.0
PORT=3000
# Ort dieser Konfigurationsdatei: nur als echte Umgebungsvariable CONFIG_FILE moeglich (Standard: .env im Projektstamm).
# Relative Pfade in der Datei gelten dann relativ zu ihr.
# DATA_DIR: Datenbank, Java-Laufzeiten (runtimes/) und Backups (backups/). Standard: <Projekt>/data,
# ausserhalb eines Projektordners ein Benutzerordner (unter Windows %LOCALAPPDATA%\LocalMC-CraftManager\data)
# DATA_DIR=C:\Git\MC-Server-Launcher\data
# SERVERS_DIR=C:\Git\MC-Server-Launcher\servers
LOG_LEVEL=info
# Optional: eigener User-Agent fuer Modrinth- und Loader-Anfragen (keine persoenlichen Daten eintragen)
# MODRINTH_USER_AGENT=LocalMC-CraftManager/0.1.0
# Optional: Ordner mit der gebauten Weboberflaeche. Standard: <Backend>/../frontend/dist, unabhaengig vom Arbeitsverzeichnis
# FRONTEND_DIR=packages/frontend/dist
# Nur Entwicklung (npm run dev): Port und Adresse des Vite-Servers, Port des Backends fuer den Proxy
# FRONTEND_PORT=5173
# FRONTEND_HOST=localhost
# BACKEND_PORT=3000
# Optional: Zugriffstoken (mindestens 8 Zeichen). Ohne Wert (und ohne in der Weboberflaeche gesetztes Passwort) gibt es
# KEINE Anmeldung und jeder im Netzwerk hat vollen Zugriff auf die API. Das Token ist das erste Passwort der Weboberflaeche;
# ein eigenes Passwort laesst sich dort unter System festlegen. Als Authorization: Bearer <Token> bleibt es der Zugang
# fuer Skripte und den Update-Dienst. Passwort vergessen: 'craftmanager reset-password' (Linux) bzw. Startmenue (Windows).
# AUTH_TOKEN=
# Optional: weitere erlaubte Origins (kommagetrennt); der Vite-Dev-Proxy braucht keinen Eintrag
# ALLOWED_ORIGINS=
# Optional: weitere erlaubte Host-Namen (kommagetrennt, ohne Port). Immer erlaubt sind IP-Adressen, localhost,
# *.localhost und der Rechnername (auch mit .local, .lan, .home, .home.arpa, .fritz.box). Alles andere: 403 HOST_FORBIDDEN
# Weitere Namen lassen sich auch in der Weboberflaeche eintragen (System > Netzwerk & Zugriff).
# ALLOWED_HOSTS=craft.example.lan
# Optional: Wartezeit in Sekunden nach "stop", bevor ein Minecraft-Server hart beendet wird
STOP_TIMEOUT_SECONDS=120
# Fehlende Java-Version automatisch installieren (Eclipse Temurin von adoptium.net, nur im Datenordner, true/false)
JAVA_AUTO_INSTALL=true
# Wie viele Backups pro Mod nach Updates in mods_backup/ bzw. plugins_backup/ bleiben (1 bis 100)
MOD_BACKUP_KEEP=3
# Selbst-Update: nach neuen GitHub-Releases suchen (true/false). Gefundene Updates werden nur angezeigt und erst nach
# Bestätigung in der Weboberfläche installiert.
# UPDATE_CHECK=true
# Quelle der Releases (Besitzer/Repository) und Kanal (stable oder prerelease)
# UPDATE_REPO=dxvro/LocalMC-CraftManager
# UPDATE_CHANNEL=stable
# Countdown in Sekunden, mit dem Spieler vor dem Stoppen der Server gewarnt werden (0 bis 600)
# UPDATE_COUNTDOWN_SECONDS=60
